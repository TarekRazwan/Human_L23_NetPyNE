// =============================================================================
// HL23PV_Cell.hoc
// Standalone NetPyNE cell template: HL23PV morphology + biophysics combined.
// Axon policy: delete_axon_BPO() — preserves original AIS diameter (2 × 30 µm).
// =============================================================================

{load_file("import3d.hoc")}

begintemplate HL23PV_Cell

public init, delete_axon, delete_axon_BPO, geom_nseg
public locateSites, getLongestBranch, distribute_channels, connect2target
public initRand, cell_name, rd1, pA
public all, apical, basal, somatic, axonal
public nSecAll, nSecSoma, nSecApical, nSecBasal
public soma, dend, apic, axon, myelin
public synlist, OUprocess, rslist, roulist, siteVec

objref all, somatic, apical, axonal, basal
objref synlist, rList, rd1, sref, this, sf, OUprocess, rslist, roulist
strdef tstr, cell_name
double siteVec[2]

create soma[1], dend[1], apic[1], axon[1], myelin[1]

proc init() { local _la, _lb   localobj nl, imprt
    all     = new SectionList()
    somatic = new SectionList()
    basal   = new SectionList()
    apical  = new SectionList()
    axonal  = new SectionList()
    forall delete_section()

    cell_name = "HL23PV"
    synlist   = new List()
    OUprocess = new List()
    rslist    = new List()
    roulist   = new List()

    nl = new Import3d_SWC_read()
    nl.quiet = 1
    nl.input("morphologies/HL23PV.swc")
    imprt = new Import3d_GUI(nl, 0)
    imprt.instantiate(this)

    geom_nseg()
    delete_axon_BPO()

    initRand(1005)
    forsec this.all {
        if (diam == 0) { diam = 1 }
    }

    _la = 0   _lb = 0
    forsec "apic" { _la = _la + L }
    forsec "dend" { _lb = _lb + L }
    if ((_la + _lb) > 0) { pA = _la / (_la + _lb) } else { pA = 0 }

    biophys()
}

proc geom_nseg() { local nSec
    soma area(0.5)
    nSec = 0
    forsec all { nseg = 1 + 2*int(L/40)   nSec = nSec + 1 }
    nSecAll = nSec
    nSec = 0   forsec somatic { nSec = nSec + 1 }   nSecSoma    = nSec
    nSec = 0   forsec apical  { nSec = nSec + 1 }   nSecApical  = nSec
    nSec = 0   forsec basal   { nSec = nSec + 1 }   nSecBasal   = nSec
}

proc delete_axon() {
    forsec axonal { delete_section() }
    create axon[2]
    access axon[0] {
        L = 20   nseg = 1+2*int(L/10)   diam(0:1) = $1:$2
        all.append()   axonal.append()
    }
    access axon[1] {
        L = 30   nseg = 1+2*int(L/10)   diam(0:1) = $2:$3
        all.append()   axonal.append()
    }
    if ($4) {
        create myelin[1]
        access myelin { L = 1000   diam = $4   nseg = 1+2*int(L/100) }
        connect myelin(0), axon[1](1)
    }
    nSecAxonal = 2
    connect axon(0), soma(0.5)
    connect axon[1](0), axon[0](1)
    access soma
}

proc delete_axon_BPO() { local nsec, ais_diams1, ais_diams2
    nsec = 0
    forsec axonal { nsec = nsec + 1 }
    if (nsec == 0) {
        ais_diams1 = 1   ais_diams2 = 1
    } else if (nsec == 1) {
        ais_diams1 = axon[0].diam   ais_diams2 = axon[0].diam
    } else {
        ais_diams1 = axon[0].diam   ais_diams2 = axon[0].diam
        soma distance(0, 0.5)
        forsec axonal {
            if (distance(1, 0.5) > 60) { ais_diams2 = diam   break }
        }
    }
    forsec axonal { delete_section() }
    create axon[2]
    access axon[0] {
        L=30  nseg=1  diam=ais_diams1
        all.append()  axonal.append()
    }
    access axon[1] {
        L=30  nseg=1  diam=ais_diams2
        all.append()  axonal.append()
    }
    nSecAxonal = 2
    connect axon[0](0), soma[0](1)
    connect axon[1](0), axon[0](1)
    access soma
}

func getLongestBranch() { local maxL, d   localobj distallist, sref2
    sprint(tstr, "%s distance()", $s1)   execute(tstr, this)
    if (0 == strcmp($s1, "axon")) {
        sprint(tstr, "%s[0] distance(1)", $s1)   execute(tstr, this)
    }
    maxL = 0   d = 0
    distallist = new SectionList()
    forsec $s1 { sref2 = new SectionRef()   if (sref2.nchild == 0) { distallist.append() } }
    forsec distallist { d = distance(1)   if (maxL < d) { maxL = d } }
    if (maxL == 0) { $s1 { maxL = L } }
    return maxL
}

obfunc locateSites() { local maxL, site, d0, d1, siteX, i   localobj vv, ll
    ll = new List()
    sprint(tstr, "%s distance()", $s1)   execute(tstr, this)
    if (0 == strcmp($s1, "axon")) {
        sprint(tstr, "%s[0] distance(1)", $s1)   execute(tstr, this)
    }
    maxL = getLongestBranch($s1)
    site = $2   i = 0
    forsec $s1 {
        d0 = distance(0)   d1 = distance(1)
        if (d0 > d1) { d0 = distance(1)   d1 = distance(0) }
        if (site <= d1 && site >= d0) {
            siteX = (site - d0) / (d1 - d0)
            vv = new Vector()
            ll.append(vv.append(i, siteX))
        }
        i = i + 1
    }
    return ll
}

proc distribute_channels() { local dist, val, maxLength
    soma distance()
    maxLength = getLongestBranch($s1)
    forsec $s1 {
        if (0 == strcmp($s2, "Ra")) {
            Ra = $8
        } else {
            for (x) {
                if ($3==3 || $3==4 || $3==5) { dist = distance(x) } else { dist = distance(x)/maxLength }
                val = calculate_distribution($3, dist, $4, $5, $6, $7, $8)
                sprint(tstr, "%s(%-5.10f) = %-5.10f", $s2, x, val)
                execute(tstr)
            }
        }
    }
}

func calculate_distribution() { local value
    if ($1==0) { value = $3 + $2*$4 }
    if ($1==1) { value = $3 + ($4/(1+exp(($2-$5)/$6))) }
    if ($1==2) { value = $3 + $6*exp($4*($2-$5)) }
    if ($1==3) { if (($2>$5) && ($2<$6)) { value=$3 } else { value=$4 } }
    if ($1==4) { value = $3 + $6*exp($4*($2-$5)) }
    if ($1==5) { value = $3 + ($4/(1+exp(($2-$5)/$6))) }
    value = value * $7
    return value
}

proc initRand() {
    rList = new List()
    rd1   = new Random($1)
    rd1.uniform(0, 1)
}

proc connect2target() {
    soma $o2 = new NetCon(&v(1), $o1)
    $o2.threshold = -30
}

// ---------------------------------------------------------------------------
// Biophysics (translated from biophys_HL23PV.hoc)
// ---------------------------------------------------------------------------
proc biophys() {
    forsec all {
        insert pas
        insert Ih
        Ra = 100   cm = 2
        e_pas = -83.92924122901199
        g_pas = 0.00011830111773572024
        gbar_Ih = 2.7671764064314368e-05
    }
    forsec somatic {
        insert NaTg
        insert Nap
        insert K_P
        insert K_T
        insert Kv3_1
        insert Im
        insert SK
        insert Ca_HVA
        insert Ca_LVA
        insert CaDynamics
        ek = -85   ena = 50
        gbar_NaTg    = 0.49958525078702043
        vshiftm_NaTg = 0   vshifth_NaTg = 10   slopem_NaTg = 9   slopeh_NaTg = 6
        gbar_Nap     = 0.008795461417521086
        gbar_K_P     = 9.606092478937705e-06
        gbar_K_T     = 0.0011701702607527396
        gbar_Kv3_1   = 2.9921080101237565
        vshift_Kv3_1 = 0
        gbar_Im      = 0.04215865946497755
        gbar_SK      = 3.7265770903193036e-06
        gbar_Ca_HVA  = 0.00017953651378188165
        gbar_Ca_LVA  = 0.09250008555398015
        gamma_CaDynamics = 0.0005
        decay_CaDynamics = 531.0255920416845
    }
    forsec axonal {
        insert NaTg
        insert Nap
        insert K_P
        insert K_T
        insert Kv3_1
        insert Im
        insert SK
        insert Ca_HVA
        insert Ca_LVA
        insert CaDynamics
        ek = -85   ena = 50
        gbar_NaTg    = 0.10914576408883477
        vshiftm_NaTg = 0   vshifth_NaTg = 10   slopem_NaTg = 9   slopeh_NaTg = 6
        gbar_Nap     = 0.001200899579358837
        gbar_K_P     = 0.6854776593761795
        gbar_K_T     = 0.07603372775662909
        gbar_Kv3_1   = 2.988867483754507
        vshift_Kv3_1 = 0
        gbar_Im      = 0.029587905136596156
        gbar_SK      = 0.5121938998281017
        gbar_Ca_HVA  = 0.002961469262723619
        gbar_Ca_LVA  = 5.9457835817342756e-05
        gamma_CaDynamics = 0.0005
        decay_CaDynamics = 163.03538024059918
    }
}

endtemplate HL23PV_Cell
